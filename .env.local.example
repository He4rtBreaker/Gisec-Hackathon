# Which provider backs each execution environment + the classifier.
# "ollama" (local, no key) | "anthropic" (needs key) | "mock"
MIZAN_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Used when MIZAN_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Session signing secret
MIZAN_SECRET=dev-secret-change-me
