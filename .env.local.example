# Which provider backs each execution environment + the classifier.
# "ollama" (local, no key) | "anthropic" (needs key) | "mock"
MIZAN_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Used when MIZAN_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Session signing secret
MIZAN_SECRET=dev-secret-change-me

# Optional. NER-backed PII recall layer for the classifier, on top of the
# regex detectors in src/lib/classify/detectors.ts. Unset (or unreachable) is
# fine — the classifier falls back to rules alone, same as MIZAN_PROVIDER=mock
# does for the adjudicator. Start it with: docker compose up -d presidio-analyzer
PRESIDIO_URL=http://127.0.0.1:5002
